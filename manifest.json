{
  "manifest_version": 3,
  "name": "OptiPie",
  "version": "1.0.0",
  "description": "TradingView Strategy Parameter Optimizer",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": [
        "libs/jquery/jquery-3.6.0.min.js",
        "injector.js",
        "script.js"
      ],
      "css": [
        "popup/popup.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [{
    "resources": [
      "plus/get-tv-parameters.js",
      "plus/get-selectable-parameter-options.js",
      "libs/jquery/jquery-3.6.0.min.js",
      "libs/bootstrap/css/bootstrap.min.css",
      "libs/bootstrap/js/bootstrap.bundle.min.js",
      "libs/bootstrap-multiselect/css/bootstrap-multiselect.css",
      "libs/bootstrap-multiselect/js/bootstrap-multiselect.js",
      "libs/bootstrap-table/css/bootstrap-table.min.css",
      "libs/bootstrap-table/js/bootstrap-table.min.js"
    ],
    "matches": ["https://*.tradingview.com/*"]
  }],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/icons/optipie16.png",
      "32": "images/icons/optipie32.png",
      "48": "images/icons/optipie48.png",
      "128": "images/icons/optipie128.png"
    }
  },
  "icons": {
    "16": "images/icons/optipie16.png",
    "32": "images/icons/optipie32.png",
    "48": "images/icons/optipie48.png",
    "128": "images/icons/optipie128.png"
  }
}